{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(bot_config\\.json|bot_data\\.json|tracked_orders\\.json|serve\\.js|telegram_bot_server\\.js|setup_vps\\.sh|ecosystem\\.config\\.js)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_next/image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/background.mp3",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ]
}